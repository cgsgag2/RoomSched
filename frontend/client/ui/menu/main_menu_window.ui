    /* Стилизация выпадающего списка */
    QComboBox {
        background-color: #ffffff;
        border: 1px solid #a393b5;
        border-radius: 6px;
        padding: 5px 10px;
        min-height: 28px;
    }
    QComboBox::drop-down {
        border: none;
    }
    QComboBox QAbstractItemView {
        background-color: #ffffff;
        selection-background-color: #6c528d;
        selection-color: #ffffff;
        border: 1px solid #a393b5;
    }

    /* Стилизация кнопки как в остальных окнах */
    QPushButton {
        background-color: #6c528d;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        min-height: 38px;
        padding: 5px 15px;
    }
    QPushButton:hover {
        background-color: #553e72;
    }
    QPushButton:pressed {
        background-color: #3e2d53;
    }
