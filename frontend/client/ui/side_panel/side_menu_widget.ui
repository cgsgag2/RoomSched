  <property name="styleSheet">
   <string notr="true">
        /* Основной фон выезжающей панели */
        QWidget#side_menu_widget {
          background-color: #6c528d;
          border-top-right-radius: 12px;
          border-bottom-right-radius: 12px;
        }

        /* Тёмный скругленный прямоугольник для слова &quot;Меню&quot; */
        QPushButton#btnMenuClose {
          background-color: #423358;
          color: #ffffff;
          font-family: "Inter", sans-serif;
          font-size: 18px;
          font-weight: 600;
          padding: 12px;
          border-radius: 8px;
          text-align: center;
        }
        QPushButton#btnMenuClose:hover { 
          background-color: #553e72; 
        }

        /* Общий стиль для кнопок навигации (рамка со скруглением) */
        QPushButton#btnHome, QPushButton#btnRooms, QPushButton#btnBookings {
          background-color: transparent;
          color: #ffffff;
          border: 2px solid #68518c;
          border-radius: 8px;
          font-family: "Inter", sans-serif;
          font-size: 14px;
          font-weight: 500;
          text-align: left;
          padding: 10px 14px;
          min-height: 20px; /* Уменьшаем высоту */
          max-height: 45px;
        }

        QPushButton#btnHome:hover, QPushButton#btnRooms:hover, QPushButton#btnBookings:hover {
          background-color: rgba(255, 255, 255, 0.12);
          border-color: #553e72;
        }

        QPushButton.navButton:pressed {
          background-color: rgba(0, 0, 0, 0.15);
        }

        /* Кнопка &quot;Выйти&quot; в самом низу (красноватый акцент) */
        QPushButton#btnLogout {
          background-color: transparent;
          color: #bf7f7f;
          border: 2px solid #4d0819;
          border-radius: 8px;
          font-family: &quot;Inter&quot;, sans-serif;
          font-size: 14px;
          font-weight: 600;
          text-align: center;
          padding: 10px 14px;
        }

        QPushButton#btnLogout:hover {
          background-color: rgba(255, 139, 139, 0.15);
          border-color: #d16a6a;
          color: #f8abab;
        }
      </string>
